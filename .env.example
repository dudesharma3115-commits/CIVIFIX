# Copy to .env for local testing, or set these in your host's dashboard.
CIVICFIX_ENV=development            # production on the live site
CIVICFIX_SECRET=                    # REQUIRED in production: 32+ random characters
CIVICFIX_DEMO=1                     # demo accounts + sample data. Must be 0 in production
DATABASE_URL=                       # postgresql://user:pass@host:5432/db  (empty = local SQLite file)

CIVICFIX_STORAGE=local              # local | supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=               # server-side secret key. Never put it in the browser
SUPABASE_BUCKET=civicfix-media      # create this bucket as PRIVATE

CIVICFIX_ADMIN_EMAIL=               # first super admin (created once if no users exist)
CIVICFIX_ADMIN_PASSWORD=            # remove after first deploy
CIVICFIX_CONTACT_EMAIL=help@your-domain.in

SMTP_HOST=smtp-relay.brevo.com      # any SMTP provider
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CivicFix <no-reply@your-domain.in>"
CIVICFIX_REQUIRE_VERIFY=1           # email OTP at sign-up (on automatically when SMTP is set)
